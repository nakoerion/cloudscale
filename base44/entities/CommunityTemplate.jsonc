{
  "name": "CommunityTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "description": {
      "type": "string",
      "description": "Template description"
    },
    "category": {
      "type": "string",
      "enum": [
        "business",
        "content",
        "social",
        "analytics",
        "starter"
      ],
      "default": "starter"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Template tags for search"
    },
    "preview_image": {
      "type": "string",
      "description": "Template preview image URL"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Included features"
    },
    "template_config": {
      "type": "object",
      "description": "Template configuration data"
    },
    "author_name": {
      "type": "string"
    },
    "author_email": {
      "type": "string"
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "average_rating": {
      "type": "number",
      "default": 0
    },
    "review_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "name",
    "description",
    "category",
    "author_email"
  ]
}